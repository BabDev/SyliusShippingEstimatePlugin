{
    "name": "babdev/sylius-shipping-estimate-plugin",
    "type": "sylius-plugin",
    "keywords": [
        "sylius",
        "sylius-plugin",
        "shipping-estimate"
    ],
    "description": "Shipping estimate plugin for Sylius.",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "friendsofsymfony/rest-bundle": "^3.0",
        "sylius/sylius": "~1.12.0",
        "symfony/config": "^5.4 || ^6.4",
        "symfony/dependency-injection": "^5.4 || ^6.4",
        "symfony/event-dispatcher-contracts": "^2.5 || ^3.0",
        "symfony/expression-language": "^5.4 || ^6.4",
        "symfony/form": "^5.4 || ^6.4",
        "symfony/framework-bundle": "^5.4 || ^6.4",
        "symfony/http-foundation": "^5.4 || ^6.4",
        "symfony/http-kernel": "^5.4 || ^6.4",
        "twig/twig": "^2.15 || ^3.3"
    },
    "require-dev": {
        "behat/behat": "^3.10",
        "behat/mink": "^1.13",
        "behat/mink-selenium2-driver": "^1.5",
        "dmore/behat-chrome-extension": "^1.3",
        "dmore/chrome-mink-driver": "^2.8",
        "friends-of-behat/mink-browserkit-driver": "^1.6",
        "friends-of-behat/mink-debug-extension": "^2.1",
        "friends-of-behat/mink-extension": "^2.6",
        "friends-of-behat/page-object-extension": "^0.3.2",
        "friends-of-behat/suite-settings-extension": "^1.1",
        "friends-of-behat/symfony-extension": "^2.3",
        "friends-of-behat/variadic-extension": "^1.4",
        "matthiasnoback/symfony-dependency-injection-test": "^4.3 || ^5.0",
        "phpspec/phpspec": "^7.5",
        "phpstan/extension-installer": "^1.2",
        "phpstan/phpstan": "2.2.2",
        "phpstan/phpstan-doctrine": "2.0.27",
        "phpstan/phpstan-strict-rules": "2.0.11",
        "phpstan/phpstan-webmozart-assert": "2.0.0",
        "phpunit/phpunit": "^9.6.34",
        "polishsymfonycommunity/symfony-mocker-container": "^1.0",
        "rector/rector": "2.5.2",
        "sylius-labs/coding-standard": "^4.4",
        "symfony/browser-kit": "^5.4 || ^6.4",
        "symfony/debug-bundle": "^5.4 || ^6.4",
        "symfony/dotenv": "^5.4 || ^6.4",
        "symfony/intl": "^5.4 || ^6.4",
        "symfony/rate-limiter": "^5.4 || ^6.4",
        "symfony/web-profiler-bundle": "^5.4 || ^6.4",
        "symfony/webpack-encore-bundle": "^1.16"
    },
    "suggest": {
        "symfony/rate-limiter": "Allows the shipping estimate endpoint to be rate limited (^5.4 || ^6.4)"
    },
    "config": {
        "allow-plugins": {
            "composer/package-versions-deprecated": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true,
            "symfony/thanks": true
        },
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "BabDev\\SyliusShippingEstimatePlugin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\BabDev\\SyliusShippingEstimatePlugin\\": "tests/"
        },
        "classmap": [
            "tests/Application/Kernel.php"
        ]
    },
    "scripts": {
        "post-install-cmd": [
            "@php bin/create_node_symlink.php"
        ],
        "post-update-cmd": [
            "@php bin/create_node_symlink.php"
        ],
        "post-create-project-cmd": [
            "@php bin/create_node_symlink.php"
        ]
    }
}
