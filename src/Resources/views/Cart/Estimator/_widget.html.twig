{% form_theme form '@SyliusShop/Form/theme.html.twig' %}

<div class="ui segment" {{ sylius_test_html_attribute('cart-shipping-estimator') }}>
    <h2 class="ui dividing header">{{ 'babdev_sylius_shipping_estimate.ui.estimate_shipping_costs'|trans }}</h2>

    {% set estimator_attributes = {
        'class': 'ui form',
        'novalidate': 'novalidate',
        'id': 'sylius-shipping-estimator',
        'data-url': path('babdev_sylius_shipping_estimate_shop_ajax_estimate_shipping'),
        'data-message-incomplete-form': 'babdev_sylius_shipping_estimate.ui.please_fill_in_all_fields_to_estimate_your_shipping'|trans,
        'data-message-calculator-error': 'babdev_sylius_shipping_estimate.ui.sorry_there_was_a_temporary_error_calculating_shipping'|trans,
        'data-message-estimate-cancelled': 'babdev_sylius_shipping_estimate.ui.the_shipping_estimate_was_cancelled'|trans,
        'data-message-generic-error': 'babdev_sylius_shipping_estimate.ui.error_getting_shipping_estimates_please_try_again'|trans,
        'data-message-rate-limited': 'babdev_sylius_shipping_estimate.ui.shipping_estimates_requested_too_quickly'|trans,
    } %}

    {{ form_start(form, {'attr': estimator_attributes}) }}

    <div class="ui stackable two column grid">
        <div class="column">
            {% include '@SyliusShop/Common/Form/_countryCode.html.twig' with {'form': form.country, 'type': 'shipping-estimate'} %}

            {{ form_row(form.postcode) }}
        </div>
        <div class="column">
            <div class="ui compact info message visible" id="sylius-shipping-estimator-enter-address" {{ sylius_test_html_attribute('enter-address-message') }}>
                {{ 'babdev_sylius_shipping_estimate.ui.enter_your_address_to_view_shipping_options'|trans }}
            </div>
            <div class="ui compact message hidden" id="sylius-shipping-estimator-no-shipping-options" {{ sylius_test_html_attribute('no-shipping-options-message') }}>
                <div class="header">{{ 'babdev_sylius_shipping_estimate.ui.shipping_not_available'|trans }}</div>
                <p>{{ 'babdev_sylius_shipping_estimate.ui.sorry_shipping_is_not_available_to_this_address'|trans }}</p>
            </div>
            <table class="ui basic table" id="sylius-shipping-estimator-shipping-options" style="display: none" {{ sylius_test_html_attribute('shipping-options') }}>
                <thead>
                    <tr>
                        <th>{{ 'babdev_sylius_shipping_estimate.ui.method'|trans }}</th>
                        <th>{{ 'babdev_sylius_shipping_estimate.ui.cost'|trans }}</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
        <div class="sixteen wide column">
            <button type="submit" class="ui primary fluid icon labeled button" {{ sylius_test_html_attribute('estimate-shipping') }}><i class="shipping fast icon"></i> {{ 'babdev_sylius_shipping_estimate.ui.view_estimate'|trans }}</button>
        </div>
    </div>

    {{ form_end(form, {'render_rest': false}) }}

    <div class="ui error message hidden" id="sylius-shipping-estimator-error" {{ sylius_test_html_attribute('shipping-estimator-error') }}></div>
</div>
